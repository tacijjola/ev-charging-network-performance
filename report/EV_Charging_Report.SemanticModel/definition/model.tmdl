model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// parameters (file paths, dates, switches)
queryGroup 00_Params

	annotation PBI_QueryGroupOrder = 0

/// one query per source file, cleaned but not shaped
/// (Enable load OFF)
queryGroup 01_Staging

	annotation PBI_QueryGroupOrder = 1

/// Dimension Tables
queryGroup 02_Dim

	annotation PBI_QueryGroupOrder = 2

/// Fact Tables
queryGroup 03_Fact

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Src_Sessions","p_DataFolder","Fact_Sessions","QA_Rejected","Dim_Date","Dim_Station","Dim_Time","Dim_User","Dim_EndReason","Helper_PortCount","_Measures Core volume","_Measures Session averages","_Measures Operational","_Measures Reliability","_Measures Time intelligence","_Measures Users","_Measures Ranking and share","_Measures Data quality (for the method page)","_Measures Dynamic titles and narrative (put these in card/title boxes)","_Benchmark measures","raw → clean"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table Fact_Sessions
ref table Dim_Station
ref table Dim_Date
ref table Dim_Time
ref table Dim_User
ref table Dim_EndReason
ref table '_Measures Core volume'
ref table '_Measures Session averages'
ref table '_Measures Operational'
ref table '_Measures Reliability'
ref table '_Measures Time intelligence'
ref table '_Measures Users'
ref table '_Measures Ranking and share'
ref table '_Measures Data quality (for the method page)'
ref table '_Measures Dynamic titles and narrative (put these in card/title boxes)'
ref table '_Benchmark measures'
ref table 'raw → clean'

ref cultureInfo en-GB

