table '_Measures Data quality (for the method page)'
	lineageTag: 6b831321-fadf-495a-a3aa-c9d991214263

	measure 'Anomaly Sessions' = CALCULATE([Total Sessions], Fact_Sessions[IsDurationAnomaly] = TRUE())
		formatString: 0
		lineageTag: 7b0b0fdc-ee27-4447-8be3-cf219a3e8816

	measure 'Long Sessions (>24h)' = CALCULATE([Total Sessions], Fact_Sessions[IsLongSession] = TRUE())
		formatString: 0
		lineageTag: ec8d6b30-35c1-4adc-b0d0-a0f0e0e73e45

	measure 'Data Quality Note' =
			
			"Excludes 17 duplicate records and 14 non-USD sessions. " &
			FORMAT([Anomaly Sessions], "#,##0") & " sessions have charging time exceeding total duration and are excluded from idle-time analysis. " &
			FORMAT([Long Sessions (>24h)], "#,##0") & " sessions exceed 24 hours."
		lineageTag: 752beb4e-fb06-4de4-9229-6eb4aaf7dfe2

	partition '_Measures Data quality (for the method page)' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

