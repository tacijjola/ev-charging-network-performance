	column DurationBand =
			
			SWITCH(
			    TRUE(),
			    Fact_Sessions[TotalMin] < 60, "< 1h",
			    Fact_Sessions[TotalMin] < 120, "1–2h",
			    Fact_Sessions[TotalMin] < 240, "2–4h",
			    Fact_Sessions[TotalMin] < 480, "4–8h",
			    "8h +"
			)
		lineageTag: a7a7d90d-20dc-49a9-921c-9661e0f55936
		summarizeBy: none
		sortByColumn: DurationBandSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column DurationBandSort =
			
			SWITCH(
			    TRUE(),
			    Fact_Sessions[TotalMin] < 60, 1,
			    Fact_Sessions[TotalMin] < 120, 2,
			    Fact_Sessions[TotalMin] < 240, 3,
			    Fact_Sessions[TotalMin] < 480, 4,
			    5
			)
		isHidden
		formatString: 0
		lineageTag: bff47bcc-9ef9-4813-a05b-06adf4aba3cb
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Fact_Sessions = m
		mode: import
		queryGroup: 03_Fact
		source =
				let
				    Source = Src_Sessions,
				
				    #"Fixed End Date" = Table.TransformColumns(Source, {{"End Date", each
				        let t = Text.Trim(_) in
				        if t = null or t = "" then null
				        else
				          let n = try Number.FromText(t) in
				          if n[HasError]
				          then DateTime.FromText(t, [Culture = "en-US"])
				          else #datetime(1899, 12, 30, 0, 0, 0) + #duration(0, 0, 0, Number.Round(n[Value] * 86400))
				      , type datetime}}),
				
				    #"Added TotalMin" = Table.AddColumn(#"Fixed End Date", "TotalMin", each
				        Number.Round(let p = Text.Split([TotalDurationText], ":") in
				          Number.From(p{0})*60 + Number.From(p{1}) + Number.From(p{2})/60, 1), type number),
				
				    #"Added ChargingMin" = Table.AddColumn(#"Added TotalMin", "ChargingMin", each
				        Number.Round(let p = Text.Split([ChargingTimeText], ":") in
				          Number.From(p{0})*60 + Number.From(p{1}) + Number.From(p{2})/60, 1), type number),
				
				    #"Added IdleMin" = Table.AddColumn(#"Added ChargingMin", "IdleMin", each
				        [TotalMin] - [ChargingMin], type number),
				
				    #"Added DateKey" = Table.AddColumn(#"Added IdleMin", "DateKey", each
				        DateTime.Date([Start Date]), type date),
				
				    #"Added HourOfDay" = Table.AddColumn(#"Added DateKey", "HourOfDay", each
				        Time.Hour(DateTime.Time([Start Date])), Int64.Type),
				
				    #"Added Quality Flags" = Table.AddColumn(
				        Table.AddColumn(#"Added HourOfDay", "IsDurationAnomaly", each [IdleMin] < 0, type logical),
				        "IsLongSession", each [TotalMin] > 1440, type logical),
				
				    #"Removed Duplicates" = Table.Distinct(#"Added Quality Flags", {"Plug In Event Id", "Station Name", "Start Date"}),
				
				    #"Filtered to USD" = Table.SelectRows(#"Removed Duplicates", each
				        [Currency] = "USD" or [Currency] = null or [Currency] = ""),
				
				    #"Removed Dimension Columns" = Table.RemoveColumns(#"Filtered to USD",
				        {"TotalDurationText", "ChargingTimeText", "SiteName", "Address", "Latitude", "Longitude",
				         "Port Type", "Plug Type", "Currency", "Postal Code"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Removed Dimension Columns","",null,Replacer.ReplaceValue,{"User ID"})
				in
				    #"Replaced Value"

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

