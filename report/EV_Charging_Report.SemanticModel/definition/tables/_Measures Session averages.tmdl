table '_Measures Session averages'
	lineageTag: b000a19e-41f8-45f5-b135-8cf8fe506164

	measure 'Avg Energy per Session (kWh)' = AVERAGE(Fact_Sessions[EnergyKWh])
		formatString: 0.0
		lineageTag: 1f502237-6baa-43bf-877f-599cb5763551

	measure 'Avg Session Duration (h)' = DIVIDE(AVERAGE(Fact_Sessions[TotalMin]), 60)
		formatString: 0.0
		lineageTag: 63b1db6b-213f-43a3-914f-27c47c765968

	measure 'Avg Charging Time (h)' = DIVIDE(AVERAGE(Fact_Sessions[ChargingMin]), 60)
		formatString: 0.0
		lineageTag: 8fd501f1-ee72-4fa2-9d44-69870c577791

	measure 'Avg Idle Time (h)' = DIVIDE(AVERAGE(Fact_Sessions[IdleMin]), 60)
		formatString: 0.0
		lineageTag: ef60f455-ed3f-4728-8654-c6bd17bbc937

	measure 'Median Session Duration (h)' = DIVIDE(MEDIAN(Fact_Sessions[TotalMin]), 60)
		formatString: 0.0
		lineageTag: b4fe1b93-784e-436d-aa44-ba36d5c6c098

	measure 'Avg Sessions per Day' = DIVIDE([Total Sessions], DISTINCTCOUNT(Dim_Date[Date]))
		lineageTag: 2d2e5d3f-5b22-4b06-b685-c4fd3438f6a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Session Minutes' =
			
			DIVIDE ( SUM ( Fact_Sessions[TotalMin] ), [Total Sessions] )
		lineageTag: 0d96a90a-3314-432e-aef0-cd2043d0b58f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Idle Minutes' =
			
			DIVIDE (
			    SUM ( Fact_Sessions[TotalMin] ) - SUM ( Fact_Sessions[ChargingMin] ),
			    [Total Sessions])
		lineageTag: 5720ffef-ca95-4ff1-b31e-ce7c0b3a8a69

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition '_Measures Session averages' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

