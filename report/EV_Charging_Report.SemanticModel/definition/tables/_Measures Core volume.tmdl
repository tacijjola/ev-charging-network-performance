table '_Measures Core volume'
	lineageTag: 1732a4e0-ec7b-40ab-89ec-aa54961418d8

	measure 'Total Energy (kWh)' = SUM(Fact_Sessions[EnergyKWh])
		formatString: #,0
		lineageTag: 9ed48262-40d8-4bfe-afcf-49a6eba541ad

	measure 'Total Sessions' = COUNTROWS(Fact_Sessions)
		formatString: #,0
		lineageTag: b493c87b-2e18-47e9-ab48-73d7c36d6d9a

	measure 'Total Revenue' = SUM(Fact_Sessions[FeeUSD])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: a2abc853-faa9-451e-9b22-668ab3051672

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total GHG Saved (kg)' = SUM(Fact_Sessions[GHGkg])
		lineageTag: 472a55fa-e279-4268-87b3-2a949af3ea6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Stations' = DISTINCTCOUNT(Fact_Sessions[Station Name])
		formatString: 0
		lineageTag: 68c14ff9-b1ae-4c05-8005-6813cafcfc33

	measure 'Active Users' = DISTINCTCOUNTNOBLANK(Fact_Sessions[User ID])
		formatString: #,0
		lineageTag: 0aefe904-52d7-4562-b412-840c11a0b7db

	measure 'Total Energy (MWh)' = DIVIDE(SUM(Fact_Sessions[EnergyKWh]), 1000)
		formatString: #,0.000
		lineageTag: 5070e366-96d1-4486-bdf4-bb92509ee3a1

	measure 'Charge Points' = DISTINCTCOUNT(Dim_Station[Station Name])
		formatString: 0
		lineageTag: 386c403e-4f19-483e-a5da-4d101060454e

	partition '_Measures Core volume' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

