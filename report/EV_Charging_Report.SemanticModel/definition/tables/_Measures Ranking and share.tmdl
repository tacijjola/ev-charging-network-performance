table '_Measures Ranking and share'
	lineageTag: a87fffb4-e300-45a4-afa1-0a270c77240a

	measure 'Site Rank by Energy' =
			
			RANKX(ALLSELECTED(Dim_Station[SiteName]), [Total Energy (kWh)], , DESC, DENSE)
		formatString: 0
		lineageTag: fadace5e-5f64-4cdd-b16f-985c512b472e

	measure 'Site Share of Energy %' =
			
			DIVIDE([Total Energy (kWh)], CALCULATE([Total Energy (kWh)], ALL(Dim_Station)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3f3f1d31-f537-4ffc-91a0-652262cfeac5

	measure 'Top Site by Energy' =
			
			VAR t = TOPN(1, ALLSELECTED(Dim_Station[SiteName]), [Total Energy (kWh)], DESC)
			RETURN CONCATENATEX(t, Dim_Station[SiteName], ", ")
		lineageTag: d1aa7679-4ea5-43bb-8525-79260d17b2a0

	partition '_Measures Ranking and share' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

