table Dim_Station
	lineageTag: 2d2ba872-5902-4b09-b6aa-ebfe3f5679b6

	measure Ports = COUNTROWS ( Dim_Station )
		formatString: 0
		lineageTag: c8a4ed97-4885-434d-92cf-c6f7ffd724d1

	measure PortCountMeasure = MAX(Dim_Station[PortCount])
		formatString: 0
		lineageTag: b481e8f3-e401-45ce-9877-ea56c3647c30

	measure Sites = DISTINCTCOUNT ( Dim_Station[SiteName] )
		formatString: 0
		lineageTag: a90af81b-593f-4fa4-8104-546429dbd77b

	column 'Station Name'
