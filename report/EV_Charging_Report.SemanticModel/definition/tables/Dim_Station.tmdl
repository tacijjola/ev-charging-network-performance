		lineageTag: ae69289f-ca21-4edf-8dd1-a2dfeb108e6c
		summarizeBy: none
		sourceColumn: PortType

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column PlugType
		dataType: string
		lineageTag: 2a209217-a5aa-4c0e-8f44-b8ddc7dbbfcb
		summarizeBy: none
		sourceColumn: PlugType

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column PortCount
