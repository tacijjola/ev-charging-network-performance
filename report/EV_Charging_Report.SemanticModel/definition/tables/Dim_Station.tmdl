	column Address
		dataType: string
		lineageTag: 3638a484-945e-4e44-8e24-fbea445a9556
		summarizeBy: none
		sourceColumn: Address

		annotation SummarizationSetBy = Automatic

	column FirstSessionDate =
			
			CALCULATE(
			    MIN(Fact_Sessions[DateKey]),
			    ALLEXCEPT(Dim_Station, Dim_Station[Station Name])
			)
		formatString: Short Date
		lineageTag: a68b2b1a-c1e2-4324-80f1-8da4cdb6ddad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Site Label' = Dim_Station[SiteName] & " (" & CALCULATE ( COUNTROWS ( Dim_Station ), ALLEXCEPT ( Dim_Station, Dim_Station[SiteName] ) ) & ")"
		lineageTag: ce04ad65-7cfe-4be9-ac94-75a019398f81
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Station = m
		mode: import
		queryGroup: 02_Dim
		source =
				let
				    Source = Src_Sessions,
				    #"Grouped Rows" = Table.Group(Source, {"Station Name", "SiteName"}, {
				        {"Address", each List.Max([Address]), type nullable text},
				        {"Latitude", each List.Max([Latitude]), type nullable number},
				        {"Longitude", each List.Max([Longitude]), type nullable number},
				        {"PortType", each List.Max([Port Type]), type nullable text},
				        {"PlugType", each List.Max([Plug Type]), type nullable text}}),
				    #"Merged PortCount" = Table.NestedJoin(#"Grouped Rows", {"SiteName"}, Helper_PortCount, {"SiteName"}, "pc", JoinKind.LeftOuter),
				    #"Expanded PortCount" = Table.ExpandTableColumn(#"Merged PortCount", "pc", {"PortCount"}, {"PortCount"})
				in
				    #"Expanded PortCount"

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

