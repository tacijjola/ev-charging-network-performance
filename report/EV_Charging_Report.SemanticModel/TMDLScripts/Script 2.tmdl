			changedProperty = IsHidden

			annotation SummarizationSetBy = Automatic

		hierarchy 'Date Hierarchy'
			lineageTag: ae42a862-0de1-4454-baac-68689146f5f3

			level Year
				lineageTag: bb7b01fc-7040-41b7-89ec-ea2002ca594b
				column: Year

			level MonthNo
				lineageTag: 2aa9f86f-fc6b-485e-b2c9-adc7b09fa7a1
				column: MonthNo

			level Date
				lineageTag: 1e24739a-4c9b-4266-bda0-d3049191a1f8
				column: Date

			changedProperty = IsHidden

		partition Dim_Date = m
			mode: import
			queryGroup: 02_Dim
			source =
					let
					    StartDate = #date(2011, 1, 1),
					    EndDate   = #date(2020, 12, 31),
					    Days      = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1,0,0,0)),
					    Table0    = Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}),
					    Typed     = Table.TransformColumnTypes(Table0, {{"Date", type date}}),
					    Cols      = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
					    C2  = Table.AddColumn(Cols, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
					    C3  = Table.AddColumn(C2, "MonthNo", each Date.Month([Date]), Int64.Type),
					    C4  = Table.AddColumn(C3, "MonthName", each Date.ToText([Date], [Format="MMM", Culture="en-GB"]), type text),
					    C5  = Table.AddColumn(C4, "YearMonth", each Date.ToText([Date], [Format="yyyy-MM"]), type text),
					    C6  = Table.AddColumn(C5, "YearMonthSort", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
					    C7  = Table.AddColumn(C6, "WeekdayNo", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
					    C8  = Table.AddColumn(C7, "WeekdayName", each Date.ToText([Date], [Format="ddd", Culture="en-GB"]), type text),
					    C9  = Table.AddColumn(C8, "IsWeekend", each Date.DayOfWeek([Date], Day.Monday) >= 5, type logical),
					    C10 = Table.AddColumn(C9, "Season", each
					            if List.Contains({12,1,2}, Date.Month([Date])) then "Winter"
					            else if List.Contains({3,4,5}, Date.Month([Date])) then "Spring"
					            else if List.Contains({6,7,8}, Date.Month([Date])) then "Summer"
					            else "Autumn", type text),
					    #"Changed Type" = Table.TransformColumnTypes(C10,{{"Date", type date}})
					in
					    #"Changed Type"

		changedProperty = IsHidden

		annotation PBI_NavigationStepName = Navigation

		annotation PBI_ResultType = Table

